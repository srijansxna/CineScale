# Application
APP_NAME=CineScale
DEBUG=False

# ── Local Docker (docker-compose) ─────────────────────────────────────────────
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/cinescale
# REDIS_HOST=redis
# REDIS_PORT=6379
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Render + Upstash (production) ─────────────────────────────────────────────
# Database — Render Postgres internal URL (swap postgresql:// → postgresql+asyncpg://)
DATABASE_URL=postgresql+asyncpg://user:password@host/cinescale

# Redis — Upstash (free tier at https://upstash.com)
REDIS_HOST=your-upstash-host.upstash.io
REDIS_PORT=6380
REDIS_BROKER_DB=0
REDIS_BACKEND_DB=1
REDIS_STATUS_DB=2

# Celery
CELERY_BROKER_URL=rediss://:your-upstash-password@your-upstash-host.upstash.io:6380/0
CELERY_RESULT_BACKEND=rediss://:your-upstash-password@your-upstash-host.upstash.io:6380/1

# Storage (Render disk mounted at /app/storage)
STORAGE_RAW_DIR=storage/raw
STORAGE_OUTPUT_DIR=storage/output
STORAGE_THUMBNAILS_DIR=storage/thumbnails
MAX_UPLOAD_SIZE=524288000
