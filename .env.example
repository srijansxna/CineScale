# Application
APP_NAME=CineScale
DEBUG=False

# Database (use 'postgres' hostname when running in Docker)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/cinescale

# Redis (use 'redis' hostname when running in Docker)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_BROKER_DB=0
REDIS_BACKEND_DB=1
REDIS_STATUS_DB=2

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Storage
STORAGE_RAW_DIR=storage/raw
STORAGE_OUTPUT_DIR=storage/output
STORAGE_THUMBNAILS_DIR=storage/thumbnails
MAX_UPLOAD_SIZE=524288000

# MinIO (use 'minio' hostname when running in Docker)
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_RAW=raw-videos
MINIO_BUCKET_VARIANTS=video-variants
MINIO_BUCKET_THUMBNAILS=thumbnails
MINIO_PRESIGNED_EXPIRY=3600
