# Application
APP_NAME=CineScale
DEBUG=False

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cinescale

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_BROKER_DB=0
REDIS_BACKEND_DB=1
REDIS_STATUS_DB=2

# Storage
STORAGE_RAW_DIR=storage/raw
STORAGE_OUTPUT_DIR=storage/output
STORAGE_THUMBNAILS_DIR=storage/thumbnails
MAX_UPLOAD_SIZE=524288000

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# MinIO / S3
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_RAW=raw-videos
MINIO_BUCKET_VARIANTS=video-variants
MINIO_BUCKET_THUMBNAILS=thumbnails
MINIO_PRESIGNED_EXPIRY=3600
